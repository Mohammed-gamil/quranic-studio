# ─────────────────────────────────────────────────────────────────────────────
# Quranic Studio — Environment Variables
# Copy this file to .env and fill in your values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required API Keys ─────────────────────────────────────────────────────────

# Google Gemini API key (used for AI-powered features)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on (default: 3000)
PORT=3000

# Full public URL of this deployment (used for self-referential links, OAuth callbacks)
APP_URL="https://your-domain.com"

# Node environment: "production" | "development"
NODE_ENV=production

# ── Storage Paths (optional overrides) ───────────────────────────────────────

# Where rendered MP4 output files are stored (defaults to ./output)
# OUTPUT_DIR=/app/output

# Tmp directory for intermediate render files (defaults to OS tmpdir)
# TMP_DIR=/tmp/wazakkir

# ── Database ──────────────────────────────────────────────────────────────────

# Path to the SQLite database file (defaults to ./data/wazakkir.db)
# DB_PATH=/app/data/wazakkir.db
